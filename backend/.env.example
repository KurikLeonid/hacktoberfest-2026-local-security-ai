# Copy to backend/.env. Never commit backend/.env.

# Default and recommended: local Gemma 4 via Ollama. Nothing leaves the laptop.
DLP_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional "Gemma 4 via Gemini API" mode (Best Use of Gemma 4 track, weak laptops).
# WARNING: in this mode the checked text is sent to Google.
# DLP_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemma-4-31b-it
